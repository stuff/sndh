# Copy to .env for local use; in Coolify, set these in the resource's
# environment variables instead.

# Host folder holding the Opus library produced by convert/ (mounted read-only).
MUSIC_HOST_DIR=../data/opus_files

# Icecast passwords (source = Liquidsoap -> Icecast, admin = web admin pages).
ICECAST_SOURCE_PASSWORD=change-me
ICECAST_ADMIN_PASSWORD=change-me-too
# Public hostname of the stream, used in Icecast's status pages.
ICECAST_HOSTNAME=localhost
ICECAST_MAX_LISTENERS=500
ICECAST_MOUNT=atari-st.opus

# Stream encoding and transitions.
OPUS_BITRATE=64
CROSSFADE_S=3
RADIO_NAME=SNDH Radio

# Scheduler: no track replayed within the last N plays, no composer within
# the last K plays; optional periodic library rescan (seconds, 0 = off).
RECENT_TRACKS=500
RECENT_ARTISTS=3
RESCAN_INTERVAL_S=0
